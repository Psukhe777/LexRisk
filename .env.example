# ─────────────────────────────────────────────────────────────────────────────
# CLAUSE — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API ─────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Model Config (optional overrides) ────────────────────────────────────────
GROQ_MODEL=llama3-70b-8192       # or mixtral-8x7b-32768, gemma2-9b-it
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2             # low = more consistent clause detection

# ── App Config ───────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
LOG_LEVEL=INFO
